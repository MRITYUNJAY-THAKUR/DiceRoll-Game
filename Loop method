import random
diceroll = True
while diceroll:
    roller = input("Roll the dice? (y/n): ")
    if roller == "y" or roller == "Y":
        dice1 = random.randrange(1, 7)
        dice2 = random.randrange(1, 7)
        print((dice1, dice2))
    elif roller == "n" or roller == "N":
        print("Thank you for playing!")
        break
    else:
        print("Invalid entry!")
